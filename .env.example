PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=casino_user
DB_PASSWORD=change_me
DB_NAME=casino_sportsbook
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# House / risk config
HOUSE_EDGE_PERCENT=2
MAX_BET_AMOUNT=5000
MIN_BET_AMOUNT=0.5
STARTING_DEMO_BALANCE=1000

# Mock payment gateway (Paystack-shaped test double — NOT a real processor)
APP_BASE_URL=http://localhost:4000
MOCK_GATEWAY_SECRET_KEY=sk_test_51H8xk2example_change_me

# Odds-API.io (https://github.com/shem4soul/Bet-Odds-API / npm: odds-api-io)
ODDS_API_KEY=
# ODDS_API_BASE_URL=https://api2.odds-api.io/v3
# Comma-separated bookmaker ids to pull odds from, e.g. singbet,bet365
ODDS_SYNC_BOOKMAKERS=
# Which market to sync per event (README examples use 'moneyline')
ODDS_SYNC_MARKET=moneyline
# Minutes between automatic background syncs; 0 disables the scheduler
ODDS_SYNC_INTERVAL_MINUTES=0
# Required only if using the background scheduler above
ODDS_SYNC_SPORT=
ODDS_SYNC_LEAGUE=
