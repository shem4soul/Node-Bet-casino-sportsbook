# =============================================================================
# Naija Sportsbook API — environment configuration
# Copy to .env and fill in. Every variable is validated at boot (src/config/env.ts);
# the process refuses to start with invalid values.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=4000
APP_NAME=naija-sportsbook-api
APP_BASE_URL=http://localhost:4000   # public URL of this API (used in docs)
FRONTEND_URL=http://localhost:3000   # used for password-reset links & Paystack callback
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=loopback                 # e.g. 1 behind one load balancer; affects req.ip
CORS_ORIGINS=http://localhost:3000   # comma-separated; empty = allow all in dev, none in prod
DOCS_ENABLED=true                    # Swagger UI at /docs
METRICS_TOKEN=                       # if set, /metrics requires "Authorization: Bearer <token>"

# --- PostgreSQL ----------------------------------------------------------------
DATABASE_URL=postgres://sportsbook:sportsbook@localhost:5432/sportsbook
DATABASE_SSL=false                   # true for most managed Postgres (RDS, Supabase, Neon...)
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Used by docker-compose for the bundled Postgres container
POSTGRES_USER=sportsbook
POSTGRES_PASSWORD=sportsbook
POSTGRES_DB=sportsbook

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=naija-sportsbook-api
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
MIN_AGE_YEARS=18

# First admin (created/promoted by `npm run db:seed`). Password >= 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# --- Wallet ------------------------------------------------------------------
CURRENCY=NGN
DEMO_STARTING_BALANCE=0              # dev only — must be 0 in production

# --- Sportsbook risk controls (NGN) ------------------------------------------
MIN_STAKE=100
MAX_STAKE=1000000
MAX_PAYOUT=50000000
MAX_SELECTIONS=40
CASHOUT_ENABLED=true
CASHOUT_MARGIN_PERCENT=5
BOOKING_CODE_TTL_HOURS=72
CASINO_ENABLED=true

# --- Paystack (https://dashboard.paystack.com/#/settings/developers) ----------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack redirects the customer after checkout (your frontend page that
# then calls POST /api/v1/wallet/deposits/:reference/verify). Defaults to
# ${FRONTEND_URL}/wallet/deposit/callback
PAYSTACK_CALLBACK_URL=
PAYSTACK_VERIFY_ON_WEBHOOK=true      # re-confirm every charge with Paystack before crediting
PAYSTACK_ENFORCE_IP_WHITELIST=false  # also require webhook source IP to be Paystack's
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_TIMEOUT_MS=15000
MIN_DEPOSIT=100
MAX_DEPOSIT=5000000
MIN_WITHDRAWAL=1000
MAX_WITHDRAWAL=5000000
WITHDRAWAL_REVIEW_THRESHOLD=200000   # withdrawals >= this wait for admin approval
WITHDRAWAL_REQUIRE_KYC=true
WITHDRAWAL_DAILY_LIMIT=10000000

# --- Odds feed (https://odds-api.io) ------------------------------------------
ODDS_API_KEY=                        # empty = feed disabled; manage odds via admin API
ODDS_API_BASE_URL=https://api.odds-api.io/v3
ODDS_API_BOOKMAKERS=Bet365,Pinnacle  # comma-separated; which books to aggregate
ODDS_AGGREGATION=average             # average | best | first  (best = arbitrage risk!)
ODDS_MARGIN_PERCENT=5                # shaves the payout part of each price
ODDS_SYNC_CRON=*/15 * * * *
AUTO_SETTLE_FROM_FEED=false          # true = settle from feed scores without a human

# --- Background jobs ----------------------------------------------------------
# Run jobs inside the API process (simple single-container setups). With
# docker-compose the separate `worker` service runs them instead.
RUN_JOBS_IN_API=false

# --- Email (password reset) ---------------------------------------------------
SMTP_URL=                            # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=Sportsbook <no-reply@example.com>
